allow hal_sensors_default fwk_sensor_service:service_manager find;

hal_client_domain(hal_sensors_default, hal_audio)

binder_call(hal_sensors_default, hal_audio_default)
binder_call(hal_sensors_default, hal_graphics_allocator_default)
binder_call(hal_sensors_default, hal_graphics_composer_default)

allow hal_sensors_default audio_socket:sock_file rw_file_perms;
allow hal_sensors_default device:dir r_dir_perms;
allow hal_sensors_default sensors_device:chr_file r_file_perms;
allow hal_sensors_default vendor_fingerprint_sysfs:file r_file_perms;
allow hal_sensors_default hal_graphics_allocator_default_tmpfs:file rw_file_perms;
allow hal_sensors_default vendor_displayfeature_device:dir r_dir_perms;
allow hal_sensors_default vendor_displayfeature_device:chr_file r_file_perms;

r_dir_file(hal_sensors_default, sysfs_leds)
r_dir_file(hal_sensors_default, vendor_sysfs_displayfeature)
rw_dir_file(hal_sensors_default, vendor_sysfs_touch)

get_prop(hal_sensors_default, vendor_displayfeature_prop)

allow hal_sensors_default property_socket:sock_file write;

allow hal_sensors_default mtk_hal_composer_ext_service:service_manager find;

hal_client_domain(hal_sensors_default, hal_graphics_allocator)
typeattribute hal_sensors_default hal_mtk_composer_ext_client;

binder_call(hal_sensors_default, system_server)

get_prop(hal_sensors_default, vendor_sensors_prop)

allow hal_sensors_default self:capability2 block_suspend;

allow hal_sensors_default sysfs_tp_virtual_prox:file rw_file_perms;

allow hal_sensors_default input_device:dir r_dir_perms;
allow hal_sensors_default input_device:chr_file rw_file_perms;

allow hal_sensors_default sysfs_wake_lock:file r_file_perms;

allow hal_sensors_default hal_audio_default:unix_stream_socket connectto;

allow vendor_hal_citsensorservice_xiaomi_default hal_sensors_default:binder { call transfer };

binder_call(hal_sensors_default, system_suspend_server)
allow hal_sensors_default hal_system_suspend_service:service_manager find;
allow hal_sensors_default system_suspend_hwservice:hwservice_manager find;
