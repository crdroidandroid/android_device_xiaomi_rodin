hal_client_domain(hal_audio_default, hal_aidl_dms)
get_prop(hal_audio_default, vendor_mtk_audiohal_prop)

r_dir_file(hal_audio_default, persist_data_file)
r_dir_file(hal_audio_default, sysfs_therm)
rw_dir_file(hal_audio_default, sysfs_vibrator)

allow hal_audio_default audio_socket:sock_file rw_file_perms;
allow hal_audio_default hf_manager_device:chr_file rw_file_perms;
set_prop(hal_audio_default, log_tag_prop)

# CIT App
get_prop(hal_audio_default, vendor_audio_cit_prop)
allow hal_audio_default sysfs_fsm_re25:file rw_file_perms;
allow hal_audio_default sysfs_fsm_f0:file rw_file_perms;
allow hal_audio_default fs16xx_device:chr_file rw_file_perms;

# bluetooth
get_prop(hal_audio_default, vendor_mtk_bt_perf_prop)

binder_call(hal_audio_default, system_suspend_server)
allow hal_audio_default hal_system_suspend_service:service_manager find;
allow hal_audio_default system_suspend_hwservice:hwservice_manager find;

allow hal_audio_default sysfs:file rw_file_perms;

