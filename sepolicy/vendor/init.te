allow init fpsensor_socket:sock_file create_file_perms;

# Dolby Vision
allow init vendorcodec:process transition;
allow init vendorcodec:process { siginh rlimitinh };
allow init vendorcodec_exec:file { read getattr map execute open };
dontaudit init vendorcodec:process noatsecure;
type_transition init vendorcodec_exec:process vendorcodec;

# Charger
allow init sysfs_usbpd_device:file setattr;
allow init sysfs_battery_supply:file setattr;
