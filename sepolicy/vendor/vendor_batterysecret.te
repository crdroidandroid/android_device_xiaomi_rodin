type vendor_batterysecret, domain;
type vendor_batterysecret_exec, exec_type, file_type, vendor_file_type;

init_daemon_domain(vendor_batterysecret)

wakelock_use(vendor_batterysecret)

rw_dir_file(vendor_batterysecret, sysfs_batteryinfo)
rw_dir_file(vendor_batterysecret, sysfs_usb_nonplat)

allow vendor_batterysecret self:capability {
    chown
    fsetid
};

allow vendor_batterysecret kmsg_device:chr_file rw_file_perms;
allow vendor_batterysecret self:netlink_kobject_uevent_socket create_socket_perms_no_ioctl;
# E batterysecret: Unable to open: '/sys/class/power_supply/bms/authentic'
allow vendor_batterysecret sysfs:file { open read write };

set_prop(vendor_batterysecret, vendor_batterysecret_prop)

# Charger
allow vendor_batterysecret sysfs_usbpd_device:file rw_file_perms;
allow vendor_batterysecret sysfs_usb_supply:dir r_dir_perms;
allow vendor_batterysecret sysfs_usb_supply:file rw_file_perms;
allow vendor_batterysecret sysfs_usb_supply:lnk_file r_file_perms;
allow vendor_batterysecret sysfs_battery_supply:dir r_dir_perms;
allow vendor_batterysecret sysfs_battery_supply:file rw_file_perms;

binder_call(vendor_batterysecret, system_suspend_server)
allow vendor_batterysecret hal_system_suspend_service:service_manager find;
allow vendor_batterysecret system_suspend_hwservice:hwservice_manager find;
