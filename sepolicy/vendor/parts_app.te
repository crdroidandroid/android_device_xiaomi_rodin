# HAL services (DisplayFeature, TouchFeature, Fingerprint)
allow parts_app {
    hal_touchfeature_xiaomi_service
    vendor_hal_displayfeature_service
    hal_fingerprint_service
}:service_manager find;

binder_call(parts_app, hal_touchfeature_xiaomi_default)
binder_call(parts_app, vendor_hal_displayfeature_default)

# Fingerprint HAL client
hal_client_domain(parts_app, hal_fingerprint)
allow parts_app hal_fingerprint_service:service_manager find;

# Xiaomi fingerprint properties
get_prop(parts_app, vendor_fingerprint_prop)

# Hardware nodes access
allow parts_app sysfs_therm:dir search;
allow parts_app sysfs_therm:file rw_file_perms;
allow parts_app proc_stat:file rw_file_perms;

# CPU control
allow parts_app vendor_sysfs_cpu_control:file rw_file_perms;

# Fingerprint HAL
hal_client_domain(parts_app, hal_fingerprint)
allow parts_app hal_fingerprint_service:service_manager find;

# Xiaomi fingerprint properties
get_prop(parts_app, vendor_fingerprint_prop)

