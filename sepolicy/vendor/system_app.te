# batteryantiaging
hal_client_domain(system_app, hal_batteryantiaging)

# CITsensor
get_prop(system_app, vendor_fingerprint_prop)
set_prop(system_app, vendor_audio_cit_prop)
allow system_app vendor_audio_data_file:dir { write add_name search read getattr };
allow system_app vendor_audio_data_file:file { read write create getattr append open lock };
allow system_app fs16xx_device:chr_file rw_file_perms;
allow system_app sysfs_fsm_re25:file rw_file_perms;
allow system_app sysfs_fsm_f0:file rw_file_perms;

allow system_app sysfs_leds:dir search;

# Charger
allow system_app sysfs_usbpd_device:dir r_dir_perms;
allow system_app sysfs_usbpd_device:dir search;
allow system_app sysfs_usbpd_device:file rw_file_perms;
allow system_app sysfs_usb_supply:dir r_dir_perms;
allow system_app sysfs_usb_supply:file rw_file_perms;
allow system_app sysfs_battery_supply:dir r_dir_perms;
allow system_app sysfs_battery_supply:file rw_file_perms;
