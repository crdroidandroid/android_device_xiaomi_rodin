hal_client_domain(platform_app, hal_fingerprint)

binder_call(platform_app, hal_fingerprint_default)

allow platform_app vendor_fingerprint_data_file_fpdump:file r_file_perms;
r_dir_file(platform_app, vendor_sysfs_displayfeature)

get_prop(platform_app, vendor_fingerprint_prop)

allow platform_app fingerprint_vendor_data_file:file { read };
allow platform_app vendor_fingerprint_data_file_fpdump:file { read };

# Meme cam
allow platform_app proc_pressure_cpu:file read;
allow platform_app proc_pressure_io:file read;
allow platform_app sysfs_therm:dir search;
allow platform_app sysfs_therm:file { read open getattr };

# prox sensor
allow platform_app vendor_us_proximity_prop:file { read open getattr map };
allow platform_app proc_pressure_mem:file { read open getattr };
allow platform_app proc_pressure_cpu:file  { read open getattr };
allow platform_app proc_pressure_io:file  { read open getattr };

# ximi parts com.jiiov.fingerprint_factorytest
allow platform_app vendor_sysfs_displayfeature:dir { search };
allow platform_app vendor_sysfs_displayfeature:file rw_file_perms;
allow platform_app vendor_fingerprint_prop:file read;
allow platform_app_36 vendor_sysfs_displayfeature:dir { search };
allow platform_app_36 vendor_sysfs_displayfeature:file rw_file_perms;

# fingerprint factorytest (platform_app_36)
hal_client_domain(platform_app_36, hal_fingerprint)
binder_call(platform_app_36, hal_fingerprint_default)
binder_call(hal_fingerprint_default, platform_app_36)
get_prop(platform_app_36, vendor_fingerprint_prop)
