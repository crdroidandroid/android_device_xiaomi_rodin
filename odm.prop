# Audio
audio.spatializer.pose_predictor_type=2
audio.spatializer.prediction_duration_ms=50
persist.vendor.audio.ultrasoundmute.support=true
ro.vendor.audio.onetrack.audio_track_message.level=1
ro.vendor.soundtrigger.dfs.support=1

# Camera
persist.vendor.vcb.ability=true
persist.vendor.vcb.enable=false
ro.vendor.dynamiccamera.ability_level=2

# Charging
persist.vendor.smartchg=854
persist.vendor.accelerate.charge=true
persist.vendor.battery.health=true
persist.vendor.battery.health.optimise=true
persist.vendor.extreme.mode=true
persist.vendor.battery.erp=true
persist.vendor.tracking.dfs=true
persist.vendor.doublentc=1
persist.vendor.low.cutoff=true
persist.vendor.hightemp.notice=true
persist.vendor.night.charge=true
persist.vendor.smart.battMntor.V2=true
persist.vendor.region.charger=default

# Display
ro.vendor.display.RemapBrightness.MaxRemapSilkybrightness=16379
ro.vendor.display.RemapBrightness.MaxTolerancefac=1.09
ro.vendor.display.RemapBrightness.MinTolerancefac=1
ro.vendor.display.RemapBrightness.ToleranceEnable=1
ro.vendor.display.RemapBrightness.ToleranceNit=500
ro.vendor.mtk.pq.odm=true

# Radio
persist.vendor.radio.dynamic_sar=1

# Sensors
persist.vendor.sensor.onetrack=true
persist.vendor.sensor.maxbrightness=2600
persist.vendor.sensor.powbrightness=10

# Thermal
persist.vendor.tracking.dfs=true

# Xiaomi display features
persist.vendor.dc_backlight.enable=false
ro.vendor.cabc.enable=false
ro.vendor.display.all_modes_support_WCG.enable=true
ro.vendor.display.update_gray_by_temperature=true
ro.vendor.histogram.enable=1
ro.vendor.localhbm.enable=true
ro.vendor.sre.enable=false
sys.displayfeature_hidl=false
vendor.displayfeature.entry.enable=true
ro.vendor.mi_sf.hdr_enable_flatmode=true
ro.vendor.mtk.pq.aidl=true
ro.vendor.xiaomi.bl.poll=true

# Xiaomi touch features
persist.vendor.touchfeature.gameturbotool.version=v3.5
ro.vendor.touch.touchscheduler.enable=true

# SKU
ro.product.property_source_order=odm,product,vendor,system_ext,system
import /odm/etc/rodin_${ro.boot.ptcountrycode}_build.prop
import /odm/etc/${ro.boot.product.hardware.sku}_${ro.boot.hwversion}.prop
