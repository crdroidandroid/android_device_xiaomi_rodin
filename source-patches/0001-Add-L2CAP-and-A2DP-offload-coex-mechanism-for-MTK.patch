@@ -3077,15 +3083,38 @@ static void offload_vendor_callback(tBTM_VSC_CMPL* param) {
     }
   } else {
     log::verbose("Offload failed for subopcode= {}", sub_opcode);
+    if (param->opcode == VS_HCI_A2DP_OFFLOAD_ENABLE_COEX)
